# Auto-copied to ~/Library/Application Support/grok-bridge/.env on first run.
# chmod 600. Never commit real secrets.
#
# Bridge Bearer token is NOT here — it is auto-generated at:
#   ~/.config/grok-bridge/token
# and exported as GROK_BRIDGE_TOKEN when grok-bridge starts.

# Advisor Grok Bot webhook (from routine panel)
GROK_BRIDGE_ADVISOR_WEBHOOK_URL=https://example.invalid/webhook
GROK_BRIDGE_ADVISOR_WEBHOOK_AUTH=CHANGE_ME_SENDER_KEY
