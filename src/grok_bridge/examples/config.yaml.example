# Auto-copied to ~/Library/Application Support/grok-bridge/config.yaml on first run.
# Tunable knobs (non-secret). Secrets stay in .env.

server:
  # Must remain loopback for MVP (127.0.0.1 or ::1)
  host: "127.0.0.1"
  port: 18787

cli:
  # Usually http://<server.host>:<server.port>
  base_url: "http://127.0.0.1:18787"
  poll_interval_sec: 1.5
  reply_timeout_sec: 90

queue:
  max_replies: 500
